# PIMO — reescrita interna da API de projetos para o caminho real no servidor.
# O browser continua a ver apenas /api/projects/... (sem [R], logo sem redirect).
#
# Se o Apache não aplicar caminhos absolutos do SO (alguns mod_rewrite tratam-nos como URL-path),
# use uma ligação simbólica no DocumentRoot do domínio, por exemplo:
#   ln -s /home/u100505900/public_html/api/projects /caminho/do/teu/public_html/api/projects
# e remova ou comente a RewriteRule abaixo.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Auth JWT (frontend: https://pimo.pro/auth/login e /me)
  RewriteRule ^auth/login$ api/auth/index.php [L]
  RewriteRule ^me$ api/auth/index.php [L]
  RewriteRule ^users$ api/users/index.php [L]

  # Nota: a RewriteRule para api/projects foi removida intencionalmente.
  # O ficheiro public_html/api/projects/index.php existe fisicamente no disco,
  # pelo que Apache serve-o diretamente sem necessidade de rewrite.
  # A regra anterior reescrevia o URL para um caminho de SO (/home/u.../public_html/...)
  # que mod_rewrite trata como URL-path — inexistente no DocumentRoot —
  # fazendo com que POST/GET para /api/projects/ fossem servidos como index.html (SPA)
  # e causando "Erro ao sincronizar" em todos os projetos.

  # SPA React (Vite) — por último, para não capturar /me nem /auth/login
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
