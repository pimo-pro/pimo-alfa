<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Auth API — tem de vir ANTES do fallback SPA (senão /me e /auth/login vão para index.html)
  RewriteRule ^auth/login$ api/auth/index.php [L]
  RewriteRule ^me$ api/auth/index.php [L]
  RewriteRule ^users$ api/users/index.php [L]

  # Assets hashed Vite: NUNCA fallback SPA (senão MIME text/html em chunks em falta)
  RewriteRule ^assets/ - [L]
  RewriteRule ^config/ - [L]
  RewriteRule ^updates/ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
