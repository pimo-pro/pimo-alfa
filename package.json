{
  "name": "pimo-v3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copyDeployApiToDist.mjs",
    "publish": "node scripts/publish.js",
    "deploy": "git add . && git commit -m \"Auto deploy\" && git push origin main && npm run publish",
    "test": "vitest run",
    "tsc:strict": "tsc -b tsconfig.strict.json",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "pimo": "bash ./scripts/pimo.sh",
    "preview": "vite preview",
    "export:tcn:variants": "node --loader ts-node/esm scripts/export-tcn-variants.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/qrcode-generator": "^0.0.16",
    "@types/three": "^0.182.0",
    "axios": "^1.13.6",
    "dompurify": "^3.3.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "pg": "^8.19.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "three": "^0.182.0",
    "three-csg-ts": "^3.2.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
