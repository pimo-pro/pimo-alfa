@@ -0,0 +1,64 @@
+import { Link, useNavigate } from "react-router-dom";
+
+import { useAuth } from "../auth/useAuth";
+import Button from "./ui/Button";
+import Toolbar from "./ui/Toolbar";
+import "./ui/ui.css";
+
+export default function Navbar() {
+  const navigate = useNavigate();
+  const { user, logout, isAuthenticated } = useAuth();
+  const authenticated = isAuthenticated();
+  const canViewAdmin = user?.role === "admin" || user?.role === "ultra+";
+
+  return (
+    <Toolbar
+      left={
+        <div className="ui-nav-links">
+          <Link to="/dashboard" className="ui-nav-link">
+            <span className="ui-nav-link__icon" aria-hidden>Ôù╗</span>
+            <span>Dashboard</span>
+          </Link>
+          {authenticated ? (
+            <>
+              <Link to="/me" className="ui-nav-link">
+                <span className="ui-nav-link__icon" aria-hidden>Ôù╗</span>
+                <span>Me</span>
+              </Link>
+              <Link to="/projects" className="ui-nav-link">
+                <span className="ui-nav-link__icon" aria-hidden>Ôù╗</span>
+                <span>Projects</span>
+              </Link>
+            </>
+          ) : null}
+          {!authenticated ? (
+            <Link to="/register" className="ui-nav-link">
+              <span className="ui-nav-link__icon" aria-hidden>Ôù╗</span>
+              <span>Registrar</span>
+            </Link>
+          ) : null}
+          {authenticated && canViewAdmin ? (
+            <Link to="/admin/users" className="ui-nav-link">
+              <span className="ui-nav-link__icon" aria-hidden>Ôù╗</span>
+              <span>Administra├º├úo</span>
+            </Link>
+          ) : null}
+        </div>
+      }
+      right={
+        authenticated ? (
+          <>
+            <span className="ui-link">{user?.username ?? "Utilizador"}</span>
+            <Button type="button" onClick={logout}>
+              Logout
+            </Button>
+          </>
+        ) : (
+          <Button type="button" onClick={() => navigate("/login")}>
+            Login
+          </Button>
+        )
+      }
+    />
+  );
+}
