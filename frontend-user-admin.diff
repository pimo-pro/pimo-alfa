+          <Input
+            label="Sobrenome"
+            value={values.sobrenome}
+            onChange={(event) => handleNameChange("sobrenome", event.target.value)}
+            error={errors.sobrenome}
+            required
+          />
+        </div>
+        <Input
+          type="email"
+          label="Email"
+          value={values.email}
+          onChange={(event) => updateValue("email", event.target.value)}
+          error={errors.email}
+          required
+        />
+      </Section>
+
+      <Section title="Contato e localiza├º├úo">
+        <FormGroup>
+          <span className="ui-input__label">Pa├¡s</span>
+          <select
+            className="ui-input"
