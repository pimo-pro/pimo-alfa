+      "sobrenome",
+      "email",
+      "pais",
+      "telefone",
+      "numeroFiscal",
+      "cep",
+      "endereco",
+      "tipoCliente",
+      "username",
+      "senha",
+      "confirmarSenha",
+    ];
+
+    requiredFields.forEach((field) => {
+      if (!String(values[field]).trim()) {
+        nextErrors[field] = "Campo obrigat├│rio";
