+
+function getFiscalLabel(countryCode: string): string {
+  return getCountryConfig(countryCode)?.fiscalLabel ?? "N├║mero Fiscal";
+}
+
+function prepareAddressAutocomplete(_value: string): void {
+  // Preparado para integra├º├úo futura com auto-complete de endere├ºo.
+}
+
+export default function RegisterUserForm({
