+
+const Documentacao = lazy(() => import("./pages/Documentacao"));
+const AdminPanel = lazy(() => import("./pages/AdminPanel"));
+const ProjectProgress = lazy(() => import("./pages/ProjectProgress"));
+const DevPimoTest = import.meta.env.DEV
