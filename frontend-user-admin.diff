+            onChange={(event) => updateValue("codigoConvite", event.target.value)}
+          />
+          <Button type="button" onClick={handleInviteCodeCheck}>
+            Validar c├│digo
+          </Button>
+        </div>
+        {invitePermissions.length > 0 ? (
+          <div className="ui-inline-list">
