+  justify-content: space-between;
+  align-items: center;
+  gap: var(--ui-space-sm);
+  padding: var(--ui-space-sm) var(--ui-space-md);
+  border-bottom: 1px solid var(--ui-color-border);
+  margin-bottom: var(--ui-space-md);
+  background: var(--ui-color-background);
+}
+
+.ui-toolbar__left,
+.ui-toolbar__right {
+  display: flex;
+  align-items: center;
+  gap: var(--ui-space-sm);
+}
+
+.ui-link {
+  color: var(--ui-color-text);
+  text-decoration: none;
+  font-family: var(--ui-font-family);
+  font-size: var(--ui-font-size-body);
+  line-height: var(--ui-line-height-body);
+}
+
+.ui-link--primary {
+  color: var(--ui-color-primary);
+}
+
+.ui-text-danger {
+  color: var(--ui-color-danger);
+  margin: 0;
+}
+
+.ui-loader {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--ui-space-xs);
+  color: var(--ui-color-text-muted);
+  font-size: var(--ui-font-size-small);
+  line-height: var(--ui-line-height-small);
+}
+
+.ui-loader__spinner {
+  width: 14px;
+  height: 14px;
+  border-radius: var(--ui-radius-pill);
+  border: 2px solid var(--spinner-border);
+  border-top-color: var(--spinner-top);
+  animation: ui-spin 0.9s linear infinite;
+}
+
+@keyframes ui-spin {
+  from {
+    transform: rotate(0deg);
+  }
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.auth-heading {
+  margin: 0 0 var(--ui-space-md);
+  font-size: var(--ui-font-size-h1);
+  font-weight: var(--ui-font-weight-h1);
+  line-height: var(--ui-line-height-h1);
+}
+
+.projects-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-family: var(--ui-font-family);
+  font-size: var(--ui-font-size-body);
+}
+
+.ui-grid {
+  display: grid;
+  gap: var(--ui-space-sm);
+}
+
+.ui-grid--2 {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.ui-grid--4 {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.ui-inline-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--ui-space-xs);
+  align-items: center;
+}
+
+.ui-inline-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--ui-space-xs);
+}
+
+.ui-badge {
+  display: inline-flex;
+  align-items: center;
+  min-height: var(--ui-button-min-height);
+  padding: var(--ui-space-xxs) var(--ui-space-xs);
+  border: 1px solid var(--ui-color-border);
+  border-radius: var(--ui-radius-pill);
+  background: var(--ui-color-surface);
+  color: var(--ui-color-text-muted);
+  font-size: var(--ui-font-size-small);
+}
+
+.ui-text-muted {
+  margin: 0;
+  color: var(--ui-color-text-muted);
+}
+
+.ui-table-wrapper {
+  width: 100%;
+  overflow-x: auto;
+}
+
+.ui-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-family: var(--ui-font-family);
+  font-size: var(--ui-font-size-body);
+}
+
+.ui-table th,
+.ui-table td {
+  border-bottom: 1px solid var(--ui-color-border);
+  padding: var(--ui-space-xs);
+  text-align: left;
+  vertical-align: top;
+}
+
+.ui-checkbox-line {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--ui-space-xs);
+}
+
+.ui-modal-backdrop {
+  position: fixed;
+  inset: 0;
+  background: color-mix(in srgb, var(--ui-color-background) 70%, transparent);
+  padding: var(--ui-space-lg);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow-y: auto;
+}
+
+.ui-modal-backdrop .ui-card {
+  max-width: min(900px, 100%);
+}
